# Copy to .env for local development. Every value has a safe default, so an
# empty file works — this documents what is tunable, not what is required.

# --- service ---
KOE_ENVIRONMENT=local              # local | staging | production
KOE_LOG_LEVEL=INFO
KOE_STRUCTURED_LOGS=true           # JSON logs; set false for a readable console

# --- limits ---
KOE_MAX_CONCURRENT_SESSIONS=64     # each holds an audio buffer + decoder
KOE_MAX_SESSION_SECONDS=14400
KOE_MAX_REALTIME_FACTOR=4.0        # reject audio arriving far faster than realtime

# --- cost ---
KOE_SESSION_BUDGET_USD=5.0         # a runaway session is how a rounding error becomes a bill
# KOE_TENANT_BUDGET_USD=100.0

# --- behaviour ---
KOE_DEFAULT_LANGUAGE=ja
KOE_PARTIAL_INTERVAL_MS=500        # lower feels snappier and costs proportionally more
# KOE_SILENCE_TO_END_MS=900        # unset -> language-tuned (JA 900, EN 650)

# --- providers ---
# Unset -> the service runs on deterministic mocks and needs no credentials.
# KOE_ANTHROPIC_API_KEY=sk-ant-...
# KOE_OPENAI_API_KEY=sk-...
KOE_LLM_MODEL=claude-opus-5

# --- http ---
# Production refuses to start with a wildcard. Set exact origins there.
KOE_CORS_ORIGINS=["*"]
