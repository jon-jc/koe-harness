# Shared across editors so formatting is not a review topic.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{ts,js,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
# Trailing whitespace is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.tf]
indent_size = 2

[Makefile]
indent_style = tab
